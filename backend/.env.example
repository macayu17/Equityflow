# EquityFlow Backend API Configuration
# Copy this to backend/.env and fill the credentials you have.

# Market data provider preference:
# - upstox: use Upstox first, then Groww fallback
# - groww: use Groww first, then Upstox fallback
MARKET_DATA_PROVIDER=upstox

# Upstox market-data access token.
# Docs: https://upstox.com/developer/api-documentation/open-api/
UPSTOX_ACCESS_TOKEN=
# Optional OAuth app settings. When set, the UI can generate an Upstox login URL
# and exchange the returned code for a local runtime token.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000
# UPSTOX_TOKEN_FILE=backend/.upstox-token.json
# UPSTOX_API_BASE=https://api.upstox.com

# Groww fallback configuration.
# Docs: https://groww.in/trade-api/docs/curl
GROWW_API_KEY=
GROWW_API_SECRET=
# Optional direct fallback token if key+secret token exchange is unavailable.
GROWW_ACCESS_TOKEN=

# Conservative request controls to avoid API rate limits.
UPSTOX_MAX_CONCURRENT=4
UPSTOX_LTP_CACHE_TTL_SEC=3
UPSTOX_QUOTE_CACHE_TTL_SEC=5
UPSTOX_OHLC_CACHE_TTL_SEC=60
UPSTOX_OPTION_CHAIN_CACHE_TTL_SEC=15
UPSTOX_CANDLE_CACHE_TTL_SEC=30
GROWW_MAX_CONCURRENT=4
GROWW_LTP_CACHE_TTL_SEC=3
GROWW_QUOTE_CACHE_TTL_SEC=5
GROWW_OHLC_CACHE_TTL_SEC=120

# Server
HOST=127.0.0.1
PORT=8001

# CORS (comma-separated origins). Defaults to localhost origins if omitted.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
